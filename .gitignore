# Private source exports
/ChatGPT/
/Claude/
/Gemini/
/imports/*
!/imports/.gitkeep

# Generated runtime data
/runtime/
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db

# Local environments and caches
/.venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example

# Local project notes
/AGENTS.md
/DEVLOG.md
/PLAN.md
/TODO.md
/.agents/

# Operating-system files
.DS_Store
